# ============================================================
# SSMS — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
# ============================================================

# ── Django core ─────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True                        # set to False in production
DJANGO_ENV=development            # production | development
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────
# Option A: single DATABASE_URL (Railway and Render inject this automatically)
# DATABASE_URL=postgresql://ssms_user:password@localhost:5432/ssms_db

# Option B: individual vars (used when DATABASE_URL is not set)
DB_NAME=ssms_db
DB_USER=ssms_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=another-long-random-secret-for-jwt-signing
JWT_EXPIRES_DAYS=7

# ── CORS / Frontend URL ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173   # used in password reset & alert email links

# ── Email (Gmail SMTP) ───────────────────────────────────────
EMAIL_HOST_USER=smartsericulturerw@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password   # Gmail App Password — NOT your login password
DEFAULT_FROM_EMAIL=SSMS <smartsericulturerw@gmail.com>

# ── Cloudinary (disease detection image storage) ─────────────
CLOUDINARY_CLOUD_NAME=dsmpn69ux
CLOUDINARY_UPLOAD_PRESET=ssms_images

# ── AI Microservice ──────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001    # FastAPI disease detection service URL

# ── Sentry error monitoring (optional — leave blank to disable) ──
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
